# JTech Grid Control settings
#
# HOW TO USE: copy this file to data/config.env and edit it there.
#   - On Synology: File Station -> into the data folder -> upload this file,
#     rename to config.env, then right-click -> Open with Text Editor.
#   - The app also writes a fresh config.env into data/ on first start if none
#     exists, so you can edit that one instead.
#
# After editing, restart the container in Container Manager. Upgrades never
# overwrite data/config.env, and blank or missing entries fall back to sensible
# defaults.
#
# Ports are NOT set here - change those in docker-compose.yml.

# --- sign-in ---------------------------------------------------------------
OCPP_ADMIN_USER=admin
# Leave blank and a password is generated and printed to the container log on
# every start. Set a long passphrase before exposing this to the internet.
OCPP_ADMIN_PASSWORD=

# --- https -----------------------------------------------------------------
# Every hostname and IP you will type into a browser, comma-separated. The
# self-signed certificate is generated to cover exactly this list. After
# changing it, delete the data/certs folder so a new certificate is issued.
# Example: OCPP_TRUSTED_ORIGINS=ev.example.com,192.168.1.50
OCPP_TRUSTED_ORIGINS=

# --- charger ---------------------------------------------------------------
# Only this charge point id may connect. Recommended. This is your charger's
# OCPP id (set in the Teltonika app). Example: OCPP_ALLOWED_CHARGE_POINTS=EVC121
OCPP_ALLOWED_CHARGE_POINTS=

# --- initial defaults ------------------------------------------------------
# Once changed from the dashboard these live in settings.json and this is
# ignored. Set your local tariff and battery here.
OCPP_PRICE_PER_KWH=3.55
OCPP_CURRENCY=R
OCPP_BATTERY_KWH=60
OCPP_TARGET_SOC=80

# --- Solar Assistant (optional) --------------------------------------------
# Link an inverter managed by Solar Assistant so its work mode follows the
# charger. While a car is actively charging the mode is set to
# SOLAR_ASSISTANT_MODE_CHARGING; the rest of the time it returns to
# SOLAR_ASSISTANT_MODE_IDLE. Leave the host blank to disable entirely.
#
# The password is your Solar Assistant *local* device password. It never leaves
# this file. Set a local password in Solar Assistant first if you have not.
# Example: SOLAR_ASSISTANT_HOST=192.168.1.60
SOLAR_ASSISTANT_HOST=
SOLAR_ASSISTANT_USER=admin
SOLAR_ASSISTANT_PASSWORD=
# Exact work-mode strings from the Solar Assistant dropdown. Defaults suit a
# Sunsynk/Deye. Read your own inverter's exact strings off the Solar Assistant
# work-mode dropdown if they differ.
SOLAR_ASSISTANT_MODE_CHARGING=Zero export to load
SOLAR_ASSISTANT_MODE_IDLE=Zero export to CT
# Solar-aware charging thresholds (also adjustable live on the dashboard):
# while charging, share solar to the car only when solar output (W) and battery
# state of charge (%) are both at or above these.
SOLAR_MIN_PV_W=5000
SOLAR_MIN_BATTERY_SOC=40

# --- timezone --------------------------------------------------------------
# Your IANA timezone. Used for the charging schedule window and timestamps.
# Find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: Africa/Johannesburg, Europe/London, America/New_York
TZ=Africa/Johannesburg
