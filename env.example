# Copy this file to .env and edit. Upgrades never overwrite .env.
# In File Station: right-click env.example -> Copy, paste, rename to ".env"

# --- sign-in -----------------------------------------------------------
OCPP_ADMIN_USER=admin
# Leave blank and one is generated and printed to the container log each
# start. Set a long passphrase before exposing this to the internet.
OCPP_ADMIN_PASSWORD=

# --- ports -------------------------------------------------------------
OCPP_WEB_PORT=8081
OCPP_WS_PORT=9081

# --- https -------------------------------------------------------------
# Every hostname or IP you will type into a browser. The self-signed
# certificate is generated to cover exactly this list.
# Example: ev.example.com,192.168.1.50
OCPP_TRUSTED_ORIGINS=192.168.1.50
OCPP_AUTO_CERT=1
OCPP_COOKIE_SECURE=1
# Set to 1 only if a reverse proxy terminates TLS in front of this.
OCPP_TRUST_PROXY=0

# --- charger -----------------------------------------------------------
# Only this charge point id may connect. Recommended.
# Your charger's ID, set in the Teltonika app. Example: EVC121
OCPP_ALLOWED_CHARGE_POINTS=

# --- defaults the dashboard can override at runtime --------------------
OCPP_PRICE_PER_KWH=3.55
OCPP_CURRENCY=R
OCPP_BATTERY_KWH=60
OCPP_TARGET_SOC=80

TZ=Africa/Johannesburg
